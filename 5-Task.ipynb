   "source": [
    "ratings = ['4.5', '3.0', '5', '4.2']\n",
    "\n",
    "highest = 0\n",
    "\n",
    "for rating in ratings:\n",
    "    rating = float(rating)\n",
    "\n",
    "    if rating > highest:\n",
    "        highest = rating\n",
    "\n",
    "print(\"Highest rating:\", highest)"
   ]
  }
